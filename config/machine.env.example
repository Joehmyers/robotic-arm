# Machine config: the details that change between computers.
#
# Copy this file to config/machine.env and edit the copy. The copy is ignored
# by git, so each computer keeps its own. Every script in scripts/ reads it.

# USB port of each arm. Run scripts/find-port.sh to find them.
# Linux looks like /dev/ttyACM0, macOS like /dev/tty.usbmodem58760431541.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# Arm names. They must match the calibration file names in calibration/
# (calibration/follower_1.json and calibration/leader_1.json).
FOLLOWER_ID=follower_1
LEADER_ID=leader_1

# Camera number from LeRobot's camera search (lerobot-find-cameras opencv).
# Leave empty to run without a camera.
CAMERA_INDEX=
CAMERA_NAME=front
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Your Hugging Face user name. Recorded datasets are named HF_USER/DATASET_NAME.
# The access token is NOT stored here: run `huggingface-cli login` once.
HF_USER=your-hugging-face-name
DATASET_NAME=so101_demo
TASK_DESCRIPTION="Pick up the block and put it in the box"
NUM_EPISODES=5
